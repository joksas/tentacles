{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "tentacles-coffee-cron",
	"main": "worker.ts",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": ["nodejs_compat"],
	"triggers": {
		// Runs every 5 min from 04:00–06:30 UTC daily
		"crons": ["*/5 4-5 * * *", "0,5,10,15,20,25,30 6 * * *"]
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	}
}
