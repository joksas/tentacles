{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "tentacles-coffee-cron",
	"main": "worker.ts",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": ["nodejs_compat"],
	"triggers": {
		// Runs every 15 min from 04:30–08:00 UTC daily
		"crons": ["30,45 4 * * *", "*/15 5-7 * * *", "0 8 * * *"]
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	}
}
