{
  "name": "tentacles",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "generate": "graphql-codegen --config codegen.ts",
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "biome format --fix",
    "lint": "biome lint",
    "check": "biome check",
    "deploy": "pnpm run build && wrangler deploy",
    "check:cron-secrets": "wrangler secret list --config cron/wrangler.jsonc | grep -q OCTOPUS_API_KEY || (echo 'ERROR: OCTOPUS_API_KEY secret not set. Run: pnpm wrangler secret put OCTOPUS_API_KEY --config cron/wrangler.jsonc' && false)",
    "deploy:cron": "pnpm check:cron-secrets && wrangler deploy --config cron/wrangler.jsonc"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.39.2",
    "@graphql-typed-document-node/core": "3.2.0",
    "@heroui/react": "3.1.0",
    "@heroui/styles": "3.1.0",
    "@phosphor-icons/react": "2.1.10",
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/react-devtools": "0.10.5",
    "@tanstack/react-form": "1.33.0",
    "@tanstack/react-query": "5.101.0",
    "@tanstack/react-query-devtools": "5.101.0",
    "@tanstack/react-router": "1.170.11",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.19",
    "@tanstack/router-plugin": "1.168.14",
    "graphql": "16.14.1",
    "graphql-request": "7.4.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "3.8.1",
    "tailwindcss": "4.3.0",
    "usehooks-ts": "3.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@0no-co/graphqlsp": "1.15.4",
    "@biomejs/biome": "2.4.16",
    "@fontsource/varela-round": "5.2.8",
    "@graphql-codegen/cli": "7.0.0",
    "@graphql-codegen/schema-ast": "6.0.1",
    "@parcel/watcher": "2.5.6",
    "@tailwindcss/typography": "0.5.19",
    "@tanstack/devtools-vite": "0.7.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.9.1",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.8",
    "wrangler": "4.97.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
